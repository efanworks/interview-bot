{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Read(./.env.*)"
    ],
    "defaultMode": "default"
  },
  "extraKnownMarketplaces": {
    "efan-marketplace": {
      "source": {
        "source": "github",
        "repo": "efanworks/efan-marketplace"
      }
    }
  }
}
